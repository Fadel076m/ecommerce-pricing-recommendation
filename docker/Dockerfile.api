FROM python:3.11-slim
WORKDIR /app
# libgomp1 : runtime OpenMP requis par lightgbm, absent de l'image slim (sinon
# échec au démarrage : "OSError: libgomp.so.1: cannot open shared object file").
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/*
COPY requirements-api.txt .
RUN pip install --no-cache-dir --timeout 100 --retries 10 -r requirements-api.txt
COPY api/ ./api/
COPY src/forecasting/ ./src/forecasting/
COPY src/pricing/ ./src/pricing/
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
