# Cloudflare R2 (Data Lake) - compatible S3
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=ecommerce-data-lake

# PostgreSQL (Data Warehouse)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ecommerce_dw
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000

# API
API_HOST=0.0.0.0
API_PORT=8000

# Divers
RANDOM_SEED=42
ENV=dev
