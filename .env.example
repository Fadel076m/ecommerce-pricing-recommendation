# Cloudflare R2 (Data Lake) - compatible S3
# Non requis pour lancer la démo (dashboard/API) : uniquement nécessaire pour
# `make ingest` (upload vers le Data Lake). Laisser vide si vous ne faites que
# consulter le dashboard.
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=ecommerce-data-lake

# PostgreSQL (Data Warehouse)
# Le mot de passe ci-dessous est un défaut de développement local (pas un
# secret) : gardez-le tel quel pour `make demo` / `docker compose up`, ou
# changez-le si vous adaptez le projet (il doit alors être identique partout).
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ecommerce_dw
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=devlocal_ecommerce_2026

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000

# API
API_HOST=0.0.0.0
API_PORT=8000

# Divers
RANDOM_SEED=42
ENV=dev
